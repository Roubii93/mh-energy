# Victron VRM API token
# Získat na: vrm.victronenergy.com → Preferences → API tokens
VRM_TOKEN=

# Vercel Edge Config ID
# Získat na: vercel.com → Storage → Edge Config
EDGE_CONFIG_ID=

# Vercel API token (pro čtení/zápis Edge Config)
# Získat na: vercel.com → Settings → Tokens
VERCEL_TOKEN=

# Heslo pro změnu pravidel v appce (chrání uložení na server)
# Nastav libovolný řetězec, musí být shodný s tím, co zadáš v dialogu
NR_PASSWORD=
